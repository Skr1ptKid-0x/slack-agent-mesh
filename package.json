{
  "name": "slack-agent-mesh",
  "version": "0.1.0",
  "description": "Portable, open-source Slack transport and coordination layer for existing agents.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "bin": {
    "slack-agent-mesh": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "slack/manifest.json",
    "mesh.config.example.yaml",
    ".env.example",
    "skills",
    "examples",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "vitest run test/unit",
    "test:watch": "vitest test/unit",
    "test:acceptance": "vitest run test/acceptance",
    "serve": "tsx src/cli.ts serve",
    "mcp": "tsx src/cli.ts mcp",
    "doctor": "tsx src/cli.ts doctor",
    "demo": "tsx src/cli.ts demo",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "slack",
    "agents",
    "mcp",
    "socket-mode",
    "multi-agent",
    "broker",
    "orchestration"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@slack/bolt": "^5.0.0",
    "@slack/web-api": "^7.0.0",
    "yaml": "^2.9.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.0",
    "@types/node": "^22.10.0",
    "tsx": "^4.23.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.0"
  }
}

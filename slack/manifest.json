{
  "display_information": {
    "name": "Agent Mesh",
    "description": "Portable Slack transport and coordination layer for existing agents.",
    "background_color": "#1f2937"
  },
  "features": {
    "bot_user": {
      "display_name": "agent-mesh",
      "always_online": true
    },
    "slash_commands": [
      {
        "command": "/mesh",
        "description": "Address a mesh agent, e.g. /mesh @rook investigate the 500s",
        "usage_hint": "@agent your request",
        "should_escape": false
      }
    ]
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "app_mentions:read",
        "channels:history",
        "groups:history",
        "im:history",
        "mpim:history",
        "chat:write",
        "chat:write.customize",
        "commands",
        "reactions:write"
      ]
    }
  },
  "settings": {
    "event_subscriptions": {
      "bot_events": [
        "app_mention",
        "message.channels",
        "message.groups",
        "message.im",
        "message.mpim"
      ]
    },
    "interactivity": {
      "is_enabled": true
    },
    "org_deploy_enabled": false,
    "socket_mode_enabled": true,
    "token_rotation_enabled": false
  }
}

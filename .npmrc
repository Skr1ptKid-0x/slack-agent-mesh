# Supply-chain guards (see SECURITY.md, "Dependency updates").
# Skip any version published less than 1 day ago. Needs npm 11.10 or newer;
# older npm prints an "Unknown project config" warning and ignores it.
min-release-age=1
# Never run install scripts from dependencies. No current dependency needs one
# (node:sqlite is built in). If a future native module does, rebuild that one
# package explicitly with `npm rebuild <name>` instead of turning this off.
ignore-scripts=true

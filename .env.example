# Slack Agent Mesh — environment template. Copy to `.env` and fill in real values.
# NEVER commit a filled-in .env. Secrets live only in the environment.

# --- Slack (required for `serve`) ---
# Bot token (starts with xoxb-). Scopes: chat:write, chat:write.customize,
# app_mentions:read, channels:history, groups:history, im:history,
# mpim:history, reactions:write, commands.
SLACK_BOT_TOKEN=

# App-level token (starts with xapp-) with connections:write, for Socket Mode.
SLACK_APP_TOKEN=

# Signing secret (only needed if you run an HTTP receiver instead of Socket Mode).
SLACK_SIGNING_SECRET=

# --- Example webhook agent (@scout in mesh.config.example.yaml) ---
SCOUT_WEBHOOK_URL=
SCOUT_WEBHOOK_SECRET=
